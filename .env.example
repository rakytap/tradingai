TRADINGAI_DATA_PROVIDER=yfinance

# News / sentiment MCP providers (comma-separated)
TRADINGAI_NEWS_PROVIDERS=yfinance,sec_edgar,rss

# Social sentiment providers (comma-separated): reddit, x
TRADINGAI_SOCIAL_PROVIDERS=reddit
TRADINGAI_SOCIAL_WEIGHT=0.45

# Required for SEC EDGAR access (SEC fair-access policy)
SEC_IDENTITY="Your Name your@email.com"

# Reddit public API user agent (required by Reddit)
REDDIT_USER_AGENT="tradingai-news-mcp/0.1 by tradingai"

# Optional Reddit API credentials (fallback when public JSON API is blocked)
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=

# Optional providers:
# NEWS_API_KEY=
# FINNHUB_API_KEY=
# X_BEARER_TOKEN=

# Future providers:
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
# ALPACA_PAPER=true
