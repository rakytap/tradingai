TRADINGAI_DATA_PROVIDER=yfinance

# News / sentiment MCP providers (comma-separated)
TRADINGAI_NEWS_PROVIDERS=yfinance,sec_edgar,rss

# Social sentiment providers (comma-separated): reddit, x
TRADINGAI_SOCIAL_PROVIDERS=reddit
TRADINGAI_SOCIAL_WEIGHT=0.45
TRADINGAI_NEWS_SCORING_PATH=./data/news_scoring.json
TRADINGAI_NEWS_SCORING_ENABLED=1
TRADINGAI_EVENT_GRAPH_PATH=./data/event_graph.json
TRADINGAI_EVENT_GRAPH_ENABLED=1
# L3 entity-graph inbound spill into news agent score (cached neighbor snapshots)
TRADINGAI_L3_NEWS_SPILL=1
# Fallback when news_scoring.json has no l3_news_spill_alpha; tuned value overrides when NEWS_SCORING_ENABLED=1
TRADINGAI_L3_NEWS_SPILL_ALPHA=0.25

# Required for SEC EDGAR access (SEC fair-access policy)
SEC_IDENTITY="Your Name your@email.com"

# Reddit public API user agent (required by Reddit)
REDDIT_USER_AGENT="tradingai-news-mcp/0.1 by tradingai"

# Optional Reddit API credentials (fallback when public JSON API is blocked)
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=

# Optional providers:
# NEWS_API_KEY=
# FINNHUB_API_KEY=
# X_BEARER_TOKEN=

# Alpaca market data (required for tradingai-sim-download)
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
# ALPACA_PAPER=true

# Market regime MCP providers (comma-separated): yfinance, fred
TRADINGAI_REGIME_PROVIDERS=yfinance,fred

# Optional FRED API key for yield curve, inflation, and credit spread enrichment
# FRED_API_KEY=

# Predictive signal fusion MCP
TRADINGAI_PREDICT_WEIGHTS=0.45,0.35,0.20
TRADINGAI_PREDICT_HORIZONS=3,5,8
TRADINGAI_FUSION_TUNING_PATH=./data/fusion_weights.json
TRADINGAI_FUSION_TUNING_ENABLED=1

# Technical ML models (train with tradingai-train-models)
TRADINGAI_ML_MODEL_DIR=./data/models
TRADINGAI_ML_MODEL=logistic
TRADINGAI_ML_HORIZON=5
TRADINGAI_ML_BENCHMARK=SPY
TRADINGAI_DIRECTION_THRESHOLD=0.5
TRADINGAI_ML_INCLUDE_REGIME=true
TRADINGAI_MACRO_SYNC_TICKERS=SPY,VIX,HYG,LQD
TRADINGAI_PREDICT_BACKEND=fusion
# L5 cross-sectional ranking (primary ML job)
TRADINGAI_L5_RANKING=true
TRADINGAI_ML_LABEL_MODE=cross_section
TRADINGAI_ML_ALLOW_GLOBAL_FALLBACK=false
# Paper portfolio sort/weight key: combined_score (default) or ml_rank_score
TRADINGAI_PORTFOLIO_RANK_KEY=combined_score

# L0 open-dip bounce scan (alert/scan only)
# tradingai-sync-intraday pulls 1m bars from IBKR TWS; scan defaults to DB bars.
# TRADINGAI_OPEN_DIP_PCT=2.0
# TRADINGAI_OPEN_DIP_WINDOW_MINUTES=60
# TRADINGAI_OPEN_DIP_WATCHLIST_CAP=1000
# TRADINGAI_OPEN_DIP_BUY_NOTIONAL=20000
# TRADINGAI_OPEN_DIP_TARGET_RETURN=0.003835616  # default (1/365)*(7/5); also labels dip dataset
# TRADINGAI_OPEN_DIP_PROFIT_TAKER_BUFFER=0.0002 # +0.02% on profit-taker beyond target
# TRADINGAI_OPEN_DIP_SELL_TRAIL=0.001917808     # default = target_return/2; trail %
# Dip-dataset labeling (tradingai-build-dip-dataset); CLI flags override these
# TRADINGAI_DIP_LABEL_STOP_LOSS=0.006           # 0.6% below cut close → label 0 if hit first
# TRADINGAI_DIP_LABEL_HORIZON_MINUTES=15        # minutes after cut to judge 0 vs 1
# TRADINGAI_INTRADAY_INTERVAL=1m
# TRADINGAI_INTRADAY_PERIOD=5d
# IBKR TWS / Gateway for tradingai-sync-intraday (requires TWS running, API enabled)
# TRADINGAI_IBKR_HOST=127.0.0.1
# TRADINGAI_IBKR_PORT=7497          # TWS paper 7497; live 7496; Gateway paper 4002
# TRADINGAI_IBKR_CLIENT_ID=7
# TRADINGAI_IBKR_MCP_CLIENT_ID=8   # tradingai-ibkr MCP (defaults to CLIENT_ID+1)
# TRADINGAI_IBKR_PACE_SECONDS=0.35  # delay between historical requests
# TRADINGAI_IBKR_ALLOW_ORDERS=0     # set 1 to allow buy_stock / buy_stock_budget / sell_stock live placement
# TRADINGAI_IBKR_MAX_ORDER_SHARES=1000
# TRADINGAI_AUTOSELL_DIR=./data/autosell  # tradingai-autosell job state/logs
# TRADINGAI_BUY_TRAIL_DIR=./data/buy_trail  # tradingai-buy-trail state/logs
# TRADINGAI_SELL_TRAIL_DIR=./data/sell_trail  # tradingai-sell-trail state/logs
# Dip-cut recover model used by scan / dipwalk (P(profit target hit) → Prob column)
# Default: data/dip_models_alpaca/checkpoint.pt
# TRADINGAI_DIP_MODEL_CHECKPOINT=./data/dip_models_alpaca/checkpoint.pt
# TRADINGAI_DIP_MODEL_CHECKPOINT=off

# Japanese candle bounce confirmation (5m; ranking only)
# TRADINGAI_CANDLE_SCORE_HAMMER=0.30
# TRADINGAI_CANDLE_SCORE_BULLISH_ENGULF=0.25
# TRADINGAI_CANDLE_SCORE_BEARISH_ENGULF=0.30
# TRADINGAI_CANDLE_MIN_REL_VOLUME=0.5

# L3 LLM curator (propose edges; human apply). Scoring stays deterministic.
# TRADINGAI_LLM_PROVIDER=openai   # or groq
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=llama-3.3-70b-versatile
# TRADINGAI_KG_PROPOSAL_DIR=./data/kg_proposals

# PostgreSQL learning pipeline
# TRADINGAI_ENV selects the local database when TRADINGAI_DATABASE_URL is unset:
#   prod -> tradingai
#   dev  -> tradingai_dev
TRADINGAI_ENV=dev
# Optional explicit override (wins over TRADINGAI_ENV):
# TRADINGAI_DATABASE_URL=postgresql://localhost:5432/tradingai
# Open-dip simulator parameters live in src/tradingai/sim/dip_sim.toml
# (not .env). Override with tradingai-run-dip-sim --config /path/to.toml
# Equity universe for tradingai-sync-stocks (default: packaged ~1000 US names).
# Leave TRADINGAI_SYNC_TICKERS unset to use the file; set it to override with a short list.
# TRADINGAI_SYNC_TICKERS=AAPL,MSFT,NVDA
# TRADINGAI_SYNC_TICKERS_FILE=src/tradingai/data/universe/us_equities_1000.txt

# Optional extra ETF symbols (comma-separated) beyond the built-in ETF list
# TRADINGAI_ETF_TICKERS=
